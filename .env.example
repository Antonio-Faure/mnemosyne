# ─── mnemosyne ────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Master key for the encrypted credential vault (Fernet, base64 urlsafe 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MNEMOSYNE_VAULT_KEY=

# Telegram alerts (HITL: captcha, phone verify, refusal).
MNEMOSYNE_TELEGRAM_BOT_TOKEN=
MNEMOSYNE_TELEGRAM_CHAT_ID=

# LLM provider (OpenCode Go / Zen by default).
# Leave OPENCODE_API_KEY empty to reuse the token opencode already caches after
# you log in to OpenCode Go (see OPENCODE_AUTH_PATH below).
OPENCODE_API_KEY=
OPENCODE_AUTH_PATH=~/.local/share/opencode/auth.json

# Contact string embedded in the outbound User-Agent (required by Wikimedia etc.)
MNEMOSYNE_CONTACT=mnemosyne-agent <agent@example.com>

# Paths (defaults shown).
MNEMOSYNE_CONFIG=config/config.yaml
MNEMOSYNE_DATA_DIR=data
MNEMOSYNE_VAULT_PATH=vault/vault.enc
